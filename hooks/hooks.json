{
  "description": "max-kit: boot context, branch, migration and risky-command guards, evidence reminder. Active only inside a folder with max-kit.config.json.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/max-kit.mjs\" hook session --runtime claude", "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/max-kit.mjs\" hook prompt --runtime claude", "timeout": 10 }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/max-kit.mjs\" hook pre-tool --runtime claude", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/max-kit.mjs\" hook stop --runtime claude", "timeout": 15 }] }
    ]
  }
}
